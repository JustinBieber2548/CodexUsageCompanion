<Window x:Class="CodexUsageCompanion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="690"
        Height="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0">
            <TabItem Header="Monitoring">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Usage source" VerticalAlignment="Center" />
                        <ComboBox x:Name="ReaderModeBox" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="Mock scenario" VerticalAlignment="Center" />
                        <ComboBox x:Name="MockScenarioBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="2" Text="Device label" VerticalAlignment="Center" />
                        <TextBox x:Name="DeviceLabelBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="3" Text="Display time zone" VerticalAlignment="Center" />
                        <TextBox x:Name="TimeZoneBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="4" Text="Refresh while Codex is open" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="ActiveMinutesBox" Width="70" />
                            <TextBlock Text=" minutes" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Refresh while idle" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="IdleMinutesBox" Width="70" />
                            <TextBlock Text=" minutes" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" Text="Start with Windows" VerticalAlignment="Center" />
                        <CheckBox x:Name="StartupBox" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="7" Text="Experimental reader consent" TextWrapping="Wrap" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="7" Grid.Column="1">
                            <CheckBox x:Name="OAuthConsentBox"
                                      Margin="0,0,0,2">
                                <TextBlock Text="Allow read-only access to my local Codex auth file for usage requests"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="The app never refreshes, changes, logs, or uploads the Codex token. Mock mode remains the default." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Notifications">
                <StackPanel Margin="20">
                    <CheckBox x:Name="WindowsNotificationsBox"
                              Margin="0,0,0,14"
                              Content="Show Windows notifications" />
                    <CheckBox x:Name="ResetWarningBox"
                              Margin="0,0,0,14"
                              Content="Warn 10 minutes before the short-term reset" />
                    <CheckBox x:Name="ResetDetectedBox"
                              Margin="0,0,0,14"
                              Content="Notify when a reset is confirmed by a new reading" />
                    <CheckBox x:Name="EveryChangeBox"
                              Margin="0,0,0,14"
                              Content="Notify for every usage change (noisy)" />
                    <CheckBox x:Name="ActivityBox"
                              Margin="0,0,0,14"
                              Content="Notify when Codex activity or ChatGPT open/close state changes" />
                    <CheckBox x:Name="DailySummaryBox"
                              Margin="0,0,0,14"
                              Content="Show one daily summary after 9:00 in the display time zone" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Default thresholds are 10%, 5%, and 0% for the 5-hour window, and 10% and 5% for the weekly window. Each event is delivered once per reset cycle." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Cloud sync">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Supabase URL" VerticalAlignment="Center" />
                        <TextBox x:Name="SupabaseUrlBox" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="Publishable key" VerticalAlignment="Center" />
                        <TextBox x:Name="SupabaseKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="2" Text="Email" VerticalAlignment="Center" />
                        <TextBox x:Name="EmailBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="3" Text="Password" VerticalAlignment="Center" />
                        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Padding="8,6" Margin="0,0,0,12" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Save and sign in" Click="SignIn_Click" />
                            <Button Content="Sign out" Click="SignOut_Click" />
                        </StackPanel>
                        <TextBlock x:Name="CloudStatusText"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Updates">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="GitHub repository" VerticalAlignment="Center" />
                    <TextBox x:Name="RepositoryBox" Grid.Column="1" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Text="Daily update check" VerticalAlignment="Center" />
                    <CheckBox x:Name="AutoUpdateBox" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,18,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="Updates are never forced. You review release notes and approve both download and automatic installation. Settings and local history are backed up before installation; progress is shown and the app reopens afterward." />
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Save"
                    Click="Save_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
